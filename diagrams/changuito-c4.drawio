<mxfile host="app.diagrams.net" type="device"><diagram id="L1-Contexto" name="L1 Contexto"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c2" value="C4 · Nivel 1 — Contexto del sistema Changuito" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="900" height="40" as="geometry" /></mxCell><mxCell id="c3" value="&lt;b&gt;Changuito&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Sistema de software]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Centraliza catálogos y precios de múltiples supermercados, recomienda dónde conviene comprar una lista y coordina el pedido con envío a domicilio.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="340" y="340" width="380" height="160" as="geometry" /></mxCell><mxCell id="c4" value="&lt;b&gt;Cliente&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Persona]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Busca productos, arma listas, ejecuta el optimizador, confirma pedidos y sigue su estado.&lt;/font&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="220" height="130" as="geometry" /></mxCell><mxCell id="c5" value="Arma listas, optimiza y compra&lt;br&gt;[HTTPS]" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c6" value="&lt;b&gt;Supermercado&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Persona]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Administra catálogo, precios y stock por sucursal; prepara los pedidos.&lt;/font&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="320" y="60" width="220" height="130" as="geometry" /></mxCell><mxCell id="c7" value="Gestiona catálogo y pedidos&lt;br&gt;[HTTPS]" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c8" value="&lt;b&gt;Repartidor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Persona]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Retira los pedidos en cada comercio y confirma la entrega.&lt;/font&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="600" y="60" width="220" height="130" as="geometry" /></mxCell><mxCell id="c9" value="Consulta tareas, registra retiros y entregas&lt;br&gt;[HTTPS]" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c8" target="c3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c10" value="&lt;b&gt;Administrador&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Persona]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Gestiona usuarios, comercios, sucursales y zonas de cobertura.&lt;/font&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="880" y="60" width="220" height="130" as="geometry" /></mxCell><mxCell id="c11" value="Administra la plataforma&lt;br&gt;[HTTPS]" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c10" target="c3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c12" value="&lt;b&gt;ERP / sistema propio del supermercado&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Sistema externo]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Solo supermercados en Modalidad 3 (integración directa).&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="900" y="360" width="260" height="130" as="geometry" /></mxCell><mxCell id="c13" value="Envía catálogo inicial y cambios de precio/stock&lt;br&gt;[HTTPS/JSON]" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c12" target="c3"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="L2-Contenedores" name="L2 Contenedores"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c2" value="C4 · Nivel 2 — Contenedores de Changuito" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="900" height="40" as="geometry" /></mxCell><mxCell id="c3" value="&lt;b&gt;Changuito&lt;/b&gt;&lt;br&gt;[Sistema de software]" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=bottom;spacingLeft=10;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="20" y="220" width="1160" height="620" as="geometry" /></mxCell><mxCell id="c4" value="&lt;b&gt;Cliente&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Persona]&lt;/font&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="200" height="100" as="geometry" /></mxCell><mxCell id="c5" value="&lt;b&gt;Supermercado&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Persona]&lt;/font&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="360" y="60" width="200" height="100" as="geometry" /></mxCell><mxCell id="c6" value="&lt;b&gt;Administrador&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Persona]&lt;/font&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="600" y="60" width="200" height="100" as="geometry" /></mxCell><mxCell id="c7" value="&lt;b&gt;Repartidor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Persona]&lt;/font&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="900" y="60" width="200" height="100" as="geometry" /></mxCell><mxCell id="c8" value="&lt;b&gt;App Cliente&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Contenedor: HTML5, CSS3, JavaScript]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;PAW-2026-Changuito-fn. Catálogo, listas, optimizador, checkout y seguimiento de pedidos.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="60" y="270" width="260" height="140" as="geometry" /></mxCell><mxCell id="c9" value="&lt;b&gt;Backoffice&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Contenedor: HTML5, CSS3, JavaScript]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;PAW-2026-Changuito-Backoffice-fn. Paneles de supermercado y de administración.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="440" y="270" width="260" height="140" as="geometry" /></mxCell><mxCell id="c10" value="&lt;b&gt;Riders&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Contenedor: HTML5, CSS3, JavaScript]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;PAW-2026-Changuito-Riders-fn. Tareas, retiros y entregas del repartidor.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="820" y="270" width="260" height="140" as="geometry" /></mxCell><mxCell id="c11" value="&lt;b&gt;API Backend&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Contenedor: PHP]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;PAW-2026-Changuito-bn. Reglas de negocio, autenticación por rol, pedidos e integración de catálogo.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="440" y="480" width="260" height="140" as="geometry" /></mxCell><mxCell id="c12" value="&lt;b&gt;Base de datos&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Contenedor: MySQL / MariaDB]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Usuarios, catálogo, pedidos y 2 stored procedures del optimizador.&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="460" y="670" width="220" height="140" as="geometry" /></mxCell><mxCell id="c13" value="&lt;b&gt;ERP del supermercado&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Sistema externo]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Modalidad 3.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1240" y="480" width="240" height="140" as="geometry" /></mxCell><mxCell id="c14" value="Usa&lt;br&gt;[HTTPS]" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c15" value="Usa&lt;br&gt;[HTTPS]" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c16" value="Usa&lt;br&gt;[HTTPS]" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c17" value="Usa&lt;br&gt;[HTTPS]" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c18" value="Llama a la API&lt;br&gt;[HTTP/JSON]" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c8" target="c11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c19" value="Llama a la API&lt;br&gt;[HTTP/JSON]" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c20" value="Llama a la API&lt;br&gt;[HTTP/JSON]" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c21" value="Lee, escribe y ejecuta SPs&lt;br&gt;[SQL / PDO]" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c22" value="Envía catálogo y cambios&lt;br&gt;[HTTPS/JSON]" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c13" target="c11"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="L3-Componentes" name="L3 Componentes"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c2" value="C4 · Nivel 3 — Componentes de la API Backend" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="900" height="40" as="geometry" /></mxCell><mxCell id="c3" value="&lt;b&gt;Apps frontend&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Contenedores: HTML/CSS/JS]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Cliente, Backoffice y Riders&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="500" y="50" width="280" height="100" as="geometry" /></mxCell><mxCell id="c4" value="&lt;b&gt;API Backend&lt;/b&gt;&lt;br&gt;[Contenedor: PHP]" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=bottom;spacingLeft=10;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="20" y="180" width="1260" height="740" as="geometry" /></mxCell><mxCell id="c5" value="&lt;b&gt;Router&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente: PHP (src/routes)]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Punto de entrada; resuelve la ruta al Controller del módulo.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="240" y="210" width="300" height="100" as="geometry" /></mxCell><mxCell id="c6" value="&lt;b&gt;Autenticación y autorización&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente: PHP (middleware)]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Sesión PHP y control de acceso por rol.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="740" y="210" width="300" height="100" as="geometry" /></mxCell><mxCell id="c7" value="Módulos de negocio (cada uno: Controller → Service → Repository)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontStyle=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="1220" height="540" as="geometry" /></mxCell><mxCell id="c8" value="&lt;b&gt;Cuentas y acceso&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente: PHP]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Registro, login, perfil y direcciones. Usuario, Cliente, Direccion.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="340" height="140" as="geometry" /></mxCell><mxCell id="c9" value="&lt;b&gt;Catálogo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente: PHP]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Búsqueda por nombre y categoría; ficha con comparación de precios. Producto, Categoria, ProductoSucursal.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="470" y="380" width="340" height="140" as="geometry" /></mxCell><mxCell id="c10" value="&lt;b&gt;Listas y Carrito&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente: PHP]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Listas frecuentes y carrito activo con sucursal resuelta por ítem. ListaDeCompras, Carrito, ItemCarrito.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="880" y="380" width="340" height="140" as="geometry" /></mxCell><mxCell id="c11" value="&lt;b&gt;Panel Supermercado&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente: PHP]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;ABM de catálogo, precios y stock; bandeja de OrdenComercio y estados de preparación.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="550" width="340" height="140" as="geometry" /></mxCell><mxCell id="c12" value="&lt;b&gt;Pedidos&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente: PHP]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Checkout: congela el carrito en Pedido + OrdenComercio + ItemPedido; valida transiciones de estado.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="470" y="550" width="340" height="140" as="geometry" /></mxCell><mxCell id="c13" value="&lt;b&gt;Panel Repartidor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente: PHP]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Tareas asignadas, retiro por OrdenComercio y entrega; elegibilidad por ZonaCobertura.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="880" y="550" width="340" height="140" as="geometry" /></mxCell><mxCell id="c14" value="&lt;b&gt;Administración&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente: PHP]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Usuarios y roles, sucursales, zonas de cobertura, ParametroLogistico y CoeficienteDistancia.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="720" width="340" height="140" as="geometry" /></mxCell><mxCell id="c15" value="&lt;b&gt;Optimizador&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente: PHP]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Invoca los 2 stored procedures y calcula P(n) = p0 + k·(n−1)^2.5. El resultado no se persiste.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="470" y="720" width="340" height="140" as="geometry" /></mxCell><mxCell id="c16" value="&lt;b&gt;Integración de catálogo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente: PHP]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Planilla, mapeo y directa; ConfiguracionIntegracion y LogAuditoriaCarga.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="880" y="720" width="340" height="140" as="geometry" /></mxCell><mxCell id="c17" value="&lt;b&gt;Base de datos&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Contenedor: MySQL / MariaDB]&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="520" y="980" width="240" height="120" as="geometry" /></mxCell><mxCell id="c18" value="&lt;b&gt;ERP del supermercado&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Sistema externo]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Modalidad 3.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1330" y="720" width="220" height="140" as="geometry" /></mxCell><mxCell id="c19" value="Cada módulo accede a la base de datos mediante su Repository (PDO, consultas parametrizadas). Por claridad solo se dibujan las conexiones de la fila inferior." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#FFF9DB;strokeColor=#C9B458;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1330" y="210" width="240" height="130" as="geometry" /></mxCell><mxCell id="c20" value="Solicitudes&lt;br&gt;[HTTP/JSON]" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c21" value="Verifica sesión y rol" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c22" value="Despacha al Controller" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c23" value="Lee el carrito" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c12" target="c10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c24" value="Calcula costos logísticos" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c12" target="c15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c25" value="[SQL]" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c14" target="c17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c26" value="CALL SPs&lt;br&gt;[SQL]" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c15" target="c17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c27" value="[SQL]" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id