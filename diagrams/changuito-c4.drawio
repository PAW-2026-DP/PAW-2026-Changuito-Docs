="1" parent="1" source="l4o-o79" target="l4o-o77"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l4o-e87" value="5.1 / 6.1: notificarRetiro(oc)&lt;br&gt;7: entregar(p1)" style="html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=open;endSize=10;strokeWidth=1.5;fontColor=#b85450;fontStyle=1;" edge="1" parent="1" source="l4o-o79" target="l4o-o78"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l4o-e88" value="repartidor" style="html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=none;" edge="1" parent="1" source="l4o-o75" target="l4o-o80"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l4o-e89" value="ordenes" style="html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=none;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="l4o-o75" target="l4o-o76"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l4o-e90" value="ordenes" style="html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=none;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="l4o-o75" target="l4o-o77"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l4o-e91" value="sucursal" style="html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=none;" edge="1" parent="1" source="l4o-o76" target="l4o-o72"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l4o-e92" value="sucursal" style="html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=none;" edge="1" parent="1" source="l4o-o77" target="l4o-o73"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l4o-e93" value="" style="html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=none;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="l4o-o72" target="l4o-o74"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l4o-t94" value="&lt;b&gt;Reglas de estado&lt;/b&gt;&lt;br&gt;OrdenComercio: CONFIRMADO → EN_PREPARACION → LISTO_PARA_RETIRO → RETIRADO&lt;br&gt;Pedido: PENDIENTE → CONFIRMADO → ASIGNADO → EN_CAMINO → ENTREGADO&lt;br&gt;• Un único Repartidor por Pedido hace todas las paradas de retiro y la entrega.&lt;br&gt;• EN_CAMINO solo cuando todas las OrdenComercio están en RETIRADO.&lt;br&gt;• CANCELADO es alcanzable antes de EN_CAMINO y se propaga a las OrdenComercio no retiradas." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fillColor=#fffde7;strokeColor=#d6b656;spacing=8;" vertex="1" parent="1"><mxGeometry x="3640" y="730" width="640" height="200" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="L4b-Secuencia-checkout" name="L4b Secuencia checkout"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c2" value="C4 · Nivel 4 — Secuencia: optimizar lista → ajustar carrito → confirmar pedido" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="900" height="40" as="geometry" /></mxCell><mxCell id="c3" value="POST /carrito/optimizar (listaIds, direccionId)" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="150" as="sourcePoint" /><mxPoint x="300" y="150" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c4" value="armarDesdeListas(lis